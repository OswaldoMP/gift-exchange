# Configuración del servidor local Intercambio Navideño 2026
# Copia este archivo como ".env" (ignorado por Git) para usar SMTP real y clave propia.

PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:4200

# Clave secreta para cifrado AES-256-GCM en SQLite (si se omite, se genera una clave local en server/data/.encryption.key)
DATA_ENCRYPTION_KEY=cambia-esta-clave-secreta-por-una-frase-larga-y-aleatoria

# Feature flag global para el envío de correos (por defecto false). También editable desde el Panel Admin.
EMAIL_ENABLED=false

# Requerir confirmación por correo al registrarse cuando EMAIL_ENABLED=true
REQUIRE_EMAIL_CONFIRMATION=true

# Incluir el nombre del amigo secreto directamente en el correo (false mantiene la sorpresa para la ruleta)
NOTIFY_INCLUDE_FRIEND_NAME=false

# Credenciales SMTP (Gmail con contraseña de aplicación, Brevo, Resend SMTP, Mailtrap, etc.)
# Si SMTP_HOST está vacío, el servidor guarda previsualizaciones HTML en server/data/outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Intercambio Navideño 2026 <no-reply@intercambio2026.local>"

# Administrador inicial
ADMIN_EMAIL=admin@intercambio2026.local
ADMIN_PASSWORD=Admin2026!
ADMIN_NAME=Administrador
